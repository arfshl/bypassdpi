[Unit]
Description=GreenTunnel
After=network.target

[Service]
Type=simple
StandardInput=null
Environment="PATH=/home/$USER/.local/share/fnm/aliases/default/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=green-tunnel --host 127.0.0.1 --port 8900 --tls-records --no-system-proxy --quiet
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target