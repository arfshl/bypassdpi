[Unit]
Description=PowerTunnel
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/$USER/PowerTunnel
StandardInput=null
ExecStart=java -jar /home/$USER/PowerTunnel/PowerTunnel.jar --start
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target