[Unit]
Description=Tor Expert Bundle Daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/<yourtordirectory>
StandardInput=null
ExecStart=%h/<yourtordirectory>/tor -f %h/<yourtordirectory>/torrc
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target